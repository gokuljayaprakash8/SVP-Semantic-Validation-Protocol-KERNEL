    },
    {
      "step": 4,
      "authority_id": "CHILD-004",
      "resource_id": "RESOURCE-B",
      "action": "read the approved internal dataset from resource B",
      "declared_effect": "INTERNAL_READ"
    },
    {
      "step": 5,
      "authority_id": "CHILD-004",
      "resource_id": "RESOURCE-A",
      "action": "derive a combined analytical artifact from the two authorized inputs",
      "declared_effect": "INTERNAL_DERIVE",
      "input_resources": [
        "RESOURCE-A"
      ]
    },
    {
      "step": 6,
      "authority_id": "CHILD-004",
      "resource_id": "RESOURCE-A",
      "action": "prepare the combined artifact for an internal consumer",
      "declared_effect": "INTERNAL_PREPARE"
    }
  ],
  "unauthorized_aggregate_effect": "CROSS_RESOURCE_EXTERNALIZATION",
  "expected_violation": false
