{
  "case_id": "CEC-DELEGATION-012",
  "title": "Repeated resource access with one contributing input",
  "description": "RESOURCE-A and RESOURCE-B are accessed repeatedly, but only RESOURCE-A contributes to the completed analytical artifact.",
  "authorities": [
    {
      "authority_id": "PARENT-001",
      "parent_authority": null,
      "delegation_depth": 0,
      "delegated_effects": [
        "INTERNAL_READ",
        "INTERNAL_DERIVE",
        "INTERNAL_PREPARE"
      ]
    },
    {
      "authority_id": "CHILD-004",
      "parent_authority": "PARENT-001",
      "delegation_depth": 1,
      "delegated_effects": [
        "INTERNAL_READ",
        "INTERNAL_DERIVE",
        "INTERNAL_PREPARE"
      ]
    }
  ],
  "resources": [
    {
      "resource_id": "RESOURCE-A",
      "classification": "INTERNAL"
    },
    {
      "resource_id": "RESOURCE-B",
      "classification": "INTERNAL"
    }
  ],
  "actions": [
    {
      "step": 1,
      "authority_id": "CHILD-004",
      "resource_id": "RESOURCE-A",
      "action": "read the approved internal dataset from resource A",
