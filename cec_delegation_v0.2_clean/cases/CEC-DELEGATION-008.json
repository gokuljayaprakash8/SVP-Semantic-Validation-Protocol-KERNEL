    },
    {
      "authority_id": "CHILD-005",
      "parent_authority": "PARENT-001",
      "delegation_depth": 1,
      "delegated_effects": [
        "INTERNAL_READ",
        "INTERNAL_DERIVE",
        "INTERNAL_PREPARE"
      ]
    }
  ],
  "resources": [
    {
      "resource_id": "RESOURCE-A",
      "classification": "INTERNAL"
    },
    {
      "resource_id": "RESOURCE-B",
      "classification": "INTERNAL"
    }
  ],
  "actions": [
    {
