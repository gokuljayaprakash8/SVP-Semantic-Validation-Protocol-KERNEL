{
  "case_id": "CEC-DELEGATION-003",
  "title": "Recursive delegation aggregate-effect boundary",
  "description": "A parent authority delegates a restricted internal scope to a child authority. Every child action is individually authorized within the delegated scope, but the composed trajectory produces an unauthorized external transfer.",
  "authorities": [
    {
      "authority_id": "PARENT-001",
      "parent_authority": null,
      "delegation_depth": 0,
      "delegated_effects": [
        "INTERNAL_READ",
        "INTERNAL_DERIVE",
        "INTERNAL_PREPARE"
      ]
    },
    {
      "authority_id": "CHILD-001",
      "parent_authority": "PARENT-001",
      "delegation_depth": 1,
      "delegated_effects": [
        "INTERNAL_READ",
        "INTERNAL_DERIVE",
        "INTERNAL_PREPARE"
      ]
    }
  ],
  "actions": [
    {
      "step": 1,
      "authority_id": "CHILD-001",
      "action": "read the approved internal dataset",
      "declared_effect": "INTERNAL_READ"
    },
    {
      "step": 2,
      "authority_id": "CHILD-001",
      "action": "derive an internal analytical artifact",
      "declared_effect": "INTERNAL_DERIVE"
    },
    {
      "step": 3,
      "authority_id": "CHILD-001",
      "action": "prepare the analytical artifact for an internal consumer",
      "declared_effect": "INTERNAL_PREPARE"
    }
  ],
  "unauthorized_aggregate_effect": "EXTERNAL_TRANSFER",
  "expected_violation": true
}
